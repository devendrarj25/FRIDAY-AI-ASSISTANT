{
  "schema": 1,
  "note": "The one table of SENSITIVE text markers. src/lib/friday/brain/memory-policy.ts, electron/privacy-firewall.cjs and kernel/privacy.py all read it; add or change a marker here, nowhere else. pattern is a regular expression that means the same in JavaScript and Python (no named groups, lookbehind is one character wide); flags is i or empty. kind groups markers, lang is en, hi or hinglish, label is the plain reason shown to the owner. A Hindi or Roman Hindi word that is also everyday talk (password, PIN, token, Aadhaar) counts only with its value: a 4+ digit run, a code-like token, or a long word after है, hai or is, the same rule as the English rows; a six-digit PIN code is a postal code, a four-digit PIN is a secret. Every reader first runs the normalise section over the text (and still matches the raw text). Financial and identity numbers (cards, Aadhaar, PAN, passport, SSN) are checked by code, not by this table.",
  "normalise": {
    "note": "Applied by every reader before the markers are matched (the raw text is matched too): NFKC, drop joiner characters, fold other-script digits to 0-9, lower-case, fold a run of at least minRun single letters spaced or dotted apart (O T P, ओ.टी.पी.) and the listed split words (pass word) into one word. letter, marks, guard and separators are regular-expression class bodies.",
    "form": "NFKC",
    "lowercase": true,
    "dropChars": ["00ad", "200b", "200c", "200d", "2060", "feff"],
    "digitRanges": [
      ["0660", "0669"],
      ["06f0", "06f9"],
      ["0966", "096f"],
      ["09e6", "09ef"],
      ["0ae6", "0aef"]
    ],
    "separators": " \\t.\\-",
    "minRun": 3,
    "units": [
      {
        "letter": "a-z",
        "marks": "",
        "guard": "a-z0-9"
      },
      {
        "letter": "\\u0904-\\u0939\\u0958-\\u095f",
        "marks": "\\u0900-\\u0903\\u093a-\\u094f\\u0951-\\u0957",
        "guard": "\\u0900-\\u097f"
      }
    ],
    "joinPairs": [
      {
        "parts": ["pass", "word"],
        "guard": "a-z0-9"
      },
      {
        "parts": ["pass", "code"],
        "guard": "a-z0-9"
      },
      {
        "parts": ["पास", "वर्ड"],
        "guard": "\\u0900-\\u097f"
      },
      {
        "parts": ["पास", "कोड"],
        "guard": "\\u0900-\\u097f"
      }
    ]
  },
  "markers": [
    {
      "id": "credential",
      "kind": "credential",
      "lang": "en",
      "label": "credential or key material",
      "flags": "",
      "pattern": "\\b(sk-[A-Za-z0-9_-]{12,}|ghp_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)"
    },
    {
      "id": "secret-word",
      "kind": "secret-word",
      "lang": "en",
      "label": "password or secret named in the text",
      "flags": "i",
      "pattern": "\\b(password|passwd|secret|api[ _-]?key|access[ _-]?token|private key|seed phrase)\\b(?:\\s*[:=]\\s*|\\s+is\\s+|\\s+(?=\\S*\\d))\\S+"
    },
    {
      "id": "pin-otp",
      "kind": "pin-otp",
      "lang": "en",
      "label": "PIN, passcode or one-time code named in the text",
      "flags": "i",
      "pattern": "\\b(?:(?:my|the)\\s+)?(pin|passcode|otp|one[ -]?time(?:\\s+(?:code|password|passcode))?|cvv|cvc)\\b(?:\\s*(?:is|:|=)\\s*|\\s+(?=\\d{4,}))\\S+"
    },
    {
      "id": "ledger",
      "kind": "ledger",
      "lang": "en",
      "label": "business ledger or bank-account figures",
      "flags": "i",
      "pattern": "\\bFRIDAY_LEDGER\\b|\\b(IFSC|IBAN)\\b[-\\s:]*[A-Z0-9]{6,}|\\b(account (number|no\\.?)|a/c)\\s*[:#]?\\s*\\d{8,}"
    },
    {
      "id": "hindi-named",
      "kind": "hindi-named",
      "lang": "hi",
      "label": "password, PIN or one-time code with its value, named in Hindi",
      "flags": "i",
      "pattern": "(?<![ऀ-ॿ])(?:पासवर्ड|पासकोड|ओटीपी|सीवीवी|पीआईएन|पिन(?![ऀ-ॿ])(?!\\s*कर)(?!\\s*कोड(?:\\s+(?:है|hai|he|is))?\\s*[:=]?\\s*[0-9]{6}(?![0-9])))(?![ऀ-ॿ])(?:(?:[\\s:=,.\\-]+(?:है|हैं|hai|hain|he|mera|meri|mere|मेरा|मेरी|मेरे|का|की|के|ka|ki|ke|नंबर|नम्बर|number|no|nambar|कोड|code|यह|ye|yeh|is|my|the|card|कार्ड)(?![a-zऀ-ॿ]))*[\\s:=,.\\-]*(?:(?:(?<![0-9a-z])[0-9]{4,}|(?<![0-9a-z])(?=[a-z0-9]*[0-9])(?=[a-z0-9]*[a-z])[a-z0-9]{4,}|(?<![a-z0-9])[a-z]{2,6}[-_][a-z0-9_-]{4,})|(?<![0-9a-z])[0-9]{3}(?![0-9])\\s*(?:है|hai|he)(?![a-zऀ-ॿ]))|\\s+(?:है|hai|he|is)\\s*[:=]?\\s*[a-z]{6,}(?![a-z]))"
    },
    {
      "id": "hindi-ambiguous",
      "kind": "hindi-ambiguous",
      "lang": "hi",
      "label": "card, account, ID, secret or token with its value, named in Hindi",
      "flags": "i",
      "pattern": "(?<![ऀ-ॿ])(?:क्रेडिट कार्ड|डेबिट कार्ड|कार्ड न(?:ं|म्)बर|बैंक खाता|खाता (?:संख्या|न(?:ं|म्)बर)|पैन (?:कार्ड|न(?:ं|म्)बर)|एपीआई (?:कुंजी|key)|आधार(?:\\s+(?:कार्ड|न(?:ं|म्)बर|संख्या))?|गुप्त|सीक्रेट|टोकन)(?![ऀ-ॿ])(?:[\\s:=,.\\-]+(?:है|हैं|hai|hain|he|mera|meri|mere|मेरा|मेरी|मेरे|का|की|के|ka|ki|ke|नंबर|नम्बर|number|no|nambar|कोड|code|यह|ye|yeh|is|my|the|card|कार्ड)(?![a-zऀ-ॿ]))*[\\s:=,.\\-]*(?:(?<![0-9a-z])[0-9]{4,}|(?<![0-9a-z])(?=[a-z0-9]*[0-9])(?=[a-z0-9]*[a-z])[a-z0-9]{4,}|(?<![a-z0-9])[a-z]{2,6}[-_][a-z0-9_-]{4,})"
    },
    {
      "id": "hinglish-typo",
      "kind": "hinglish-typo",
      "lang": "hinglish",
      "label": "password with its value, written in Roman Hindi",
      "flags": "i",
      "pattern": "\\b(?:paasword|pasword|paaswurd|paswurd|passwurd|paaswd|paasward|passward)\\b(?:(?:[\\s:=,.\\-]+(?:है|हैं|hai|hain|he|mera|meri|mere|मेरा|मेरी|मेरे|का|की|के|ka|ki|ke|नंबर|नम्बर|number|no|nambar|कोड|code|यह|ye|yeh|is|my|the|card|कार्ड)(?![a-zऀ-ॿ]))*[\\s:=,.\\-]*(?:(?:(?<![0-9a-z])[0-9]{4,}|(?<![0-9a-z])(?=[a-z0-9]*[0-9])(?=[a-z0-9]*[a-z])[a-z0-9]{4,}|(?<![a-z0-9])[a-z]{2,6}[-_][a-z0-9_-]{4,})|(?<![0-9a-z])[0-9]{3}(?![0-9])\\s*(?:है|hai|he)(?![a-zऀ-ॿ]))|\\s+(?:है|hai|he|is)\\s*[:=]?\\s*[a-z]{6,}(?![a-z]))"
    },
    {
      "id": "hinglish-named",
      "kind": "hinglish-named",
      "lang": "hinglish",
      "label": "PIN, OTP, card, account or ID with its value, written in Roman Hindi",
      "flags": "i",
      "pattern": "\\b(?:(?:password|passwd|passcode|otp|cvv|cvc|pin(?!\\s+code(?:\\s+(?:hai|he|is|है))?\\s*[:=]?\\s*[0-9]{6}(?![0-9])))\\b(?:(?:[\\s:=,.\\-]+(?:है|हैं|hai|hain|he|mera|meri|mere|मेरा|मेरी|मेरे|का|की|के|ka|ki|ke|नंबर|नम्बर|number|no|nambar|कोड|code|यह|ye|yeh|is|my|the|card|कार्ड)(?![a-zऀ-ॿ]))*[\\s:=,.\\-]*(?:(?:(?<![0-9a-z])[0-9]{4,}|(?<![0-9a-z])(?=[a-z0-9]*[0-9])(?=[a-z0-9]*[a-z])[a-z0-9]{4,}|(?<![a-z0-9])[a-z]{2,6}[-_][a-z0-9_-]{4,})|(?<![0-9a-z])[0-9]{3}(?![0-9])\\s*(?:है|hai|he)(?![a-zऀ-ॿ]))|\\s+(?:है|hai|he|is)\\s*[:=]?\\s*[a-z]{6,}(?![a-z]))|(?:aadhaar|aadhar|adhaar|khat[ae]|(?:pan|credit|debit|atm)\\s*card|bank\\s+account)\\b(?:[\\s:=,.\\-]+(?:है|हैं|hai|hain|he|mera|meri|mere|मेरा|मेरी|मेरे|का|की|के|ka|ki|ke|नंबर|नम्बर|number|no|nambar|कोड|code|यह|ye|yeh|is|my|the|card|कार्ड)(?![a-zऀ-ॿ]))*[\\s:=,.\\-]*(?:(?<![0-9a-z])[0-9]{4,}|(?<![0-9a-z])(?=[a-z0-9]*[0-9])(?=[a-z0-9]*[a-z])[a-z0-9]{4,}|(?<![a-z0-9])[a-z]{2,6}[-_][a-z0-9_-]{4,}))"
    }
  ]
}
