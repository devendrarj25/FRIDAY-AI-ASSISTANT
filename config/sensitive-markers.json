{
  "schema": 1,
  "note": "The one table of SENSITIVE text markers. src/lib/friday/brain/memory-policy.ts, electron/privacy-firewall.cjs and kernel/privacy.py all read it; add or change a marker here, nowhere else. pattern is a regular expression that means the same in JavaScript and Python (no named groups, lookbehind is one character wide); flags is i or empty. kind groups markers, lang is en, hi or hinglish, label is the plain reason shown to the owner. A Devanagari word that is also an everyday word needs its second word, a value or its own end, so ordinary talk is not caught (a six-digit PIN code is a postal code, a four-digit PIN is a secret). Financial and identity numbers (cards, Aadhaar, PAN, passport, SSN) are checked by code, not by this table.",
  "markers": [
    {
      "id": "credential",
      "kind": "credential",
      "lang": "en",
      "label": "credential or key material",
      "flags": "",
      "pattern": "\\b(sk-[A-Za-z0-9_-]{12,}|ghp_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)"
    },
    {
      "id": "secret-word",
      "kind": "secret-word",
      "lang": "en",
      "label": "password or secret named in the text",
      "flags": "i",
      "pattern": "\\b(password|passwd|secret|api[ _-]?key|access[ _-]?token|private key|seed phrase)\\b(?:\\s*[:=]\\s*|\\s+is\\s+|\\s+(?=\\S*\\d))\\S+"
    },
    {
      "id": "pin-otp",
      "kind": "pin-otp",
      "lang": "en",
      "label": "PIN, passcode or one-time code named in the text",
      "flags": "i",
      "pattern": "\\b(?:(?:my|the)\\s+)?(pin|passcode|otp|one[ -]?time(?:\\s+(?:code|password|passcode))?|cvv|cvc)\\b(?:\\s*(?:is|:|=)\\s*|\\s+(?=\\d{4,}))\\S+"
    },
    {
      "id": "ledger",
      "kind": "ledger",
      "lang": "en",
      "label": "business ledger or bank-account figures",
      "flags": "i",
      "pattern": "\\bFRIDAY_LEDGER\\b|\\b(IFSC|IBAN)\\b[-\\s:]*[A-Z0-9]{6,}|\\b(account (number|no\\.?)|a/c)\\s*[:#]?\\s*\\d{8,}"
    },
    {
      "id": "hindi-named",
      "kind": "hindi-named",
      "lang": "hi",
      "label": "password, card, account or ID named in Hindi",
      "flags": "i",
      "pattern": "(?<![\\u0900-\\u097F])(?:पासवर्ड|पासकोड|ओटीपी|सीवीवी|क्रेडिट कार्ड|डेबिट कार्ड|कार्ड न(?:ं|म्)बर|बैंक खाता|खाता (?:संख्या|न(?:ं|म्)बर)|पैन (?:कार्ड|न(?:ं|म्)बर)|एपीआई (?:कुंजी|key)|आधार (?:कार्ड|न(?:ं|म्)बर|संख्या)|(?:मेरा|मेरी|मेरे)\\s+आधार)"
    },
    {
      "id": "hindi-ambiguous",
      "kind": "hindi-ambiguous",
      "lang": "hi",
      "label": "a Hindi word for a secret, PIN or token",
      "flags": "",
      "pattern": "(?<![\\u0900-\\u097F])(?:पिन(?![\\u0900-\\u097F])(?!\\s*कर)(?!\\s*कोड\\s*\\d{6}(?!\\d))|गुप्त(?![\\u0900-\\u097F])|सीक्रेट(?![\\u0900-\\u097F])|टोकन(?![\\u0900-\\u097F]))"
    },
    {
      "id": "hinglish-typo",
      "kind": "hinglish-typo",
      "lang": "hinglish",
      "label": "password written in Roman Hindi",
      "flags": "i",
      "pattern": "\\b(?:paasword|pasword|paaswurd|paswurd|passwurd|paaswd|paasward|passward)\\b"
    },
    {
      "id": "hinglish-named",
      "kind": "hinglish-named",
      "lang": "hinglish",
      "label": "PIN, OTP, card, account or ID named in Roman Hindi",
      "flags": "i",
      "pattern": "\\b(?:(?:mera|meri|mere|apna|apni|apne)\\s+(?:pin(?!\\s+code\\s+\\d{6}(?!\\d))|otp|cvv|cvc|password|passcode|aadhaar|aadhar|adhaar)|(?:aadhaar|aadhar|adhaar)\\s+(?:card|number|no\\.?|nambar)|(?:pin|atm\\s+pin)\\s+(?:number|no\\.?|nambar)|\\batm\\s+pin|(?:otp|pin|cvv|password)\\s+(?:hai|he)\\s*[:=]?\\s*\\d{3,}|khat[ae]\\s*(?:ka\\s+)?(?:number|no\\.?|nambar|sankhya)|(?:pan|credit|debit|atm)\\s*card\\s+(?:ka\\s+|ki\\s+)?(?:number|no\\.?|nambar|pin|cvv))\\b"
    }
  ]
}
