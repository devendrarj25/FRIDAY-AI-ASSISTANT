  "fragments": {
    "wc": "a-z0-9ऀ-ॣ",
    "lc": "a-zऀ-ॣ",
    "lead": "(?:[\\s:=,.\\-]+(?:{{words.filler}})(?![a-zऀ-ॿ]))*[\\s:=,.\\-]*",
    "valueOld": "(?:(?<![0-9a-z])[0-9]{4,}|(?<![0-9a-z])(?=[a-z0-9]*[0-9])(?=[a-z0-9]*[a-z])[a-z0-9]{4,}|(?<![a-z0-9])[a-z]{2,6}[-_][a-z0-9_-]{4,})",
    "cvv": "(?<![0-9a-z])[0-9]{3}(?![0-9])\\s*(?:है|hai|he)(?![a-zऀ-ॿ])",
    "spelled": "(?:(?:{{words.digits}})(?![{{wc}}])[ \\t,\\-]*){3,}",
    "tok": "(?!(?:{{words.filler}}|{{words.stop}}|{{words.closed}})(?![{{wc}}]))(?:[0-9]+(?![{{wc}}])|(?=(?:[0-9_-]*[{{lc}}]){3})[{{wc}}_-]+(?![{{wc}}]))",
    "val": "(?:{{spelled}}|{{tok}})",
    "marker": "(?:है|hai|he)(?![{{wc}}])",
    "after": "(?:[ \\t]+(?:है|hai|he|is)(?![{{wc}}])[ \\t]*[:=]?|[ \\t]*[:=])[ \\t]*{{val}}",
    "named": "(?:{{lead}}(?:{{valueOld}}|{{cvv}}|{{val}}[ \\t,\\-]*{{marker}})|{{after}})",
    "plain": "{{lead}}{{valueOld}}",
    "snum": "(?:{{words.digits}}|{{words.numbers}}|[0-9])(?![{{wc}}])",
    "spokenRun": "(?:{{snum}}[ \\t,\\-]*){3,}",
    "codeval": "(?:{{plain}}|{{lead}}{{spokenRun}})"
  },
  "markers": [
    {
      "id": "credential",
      "kind": "credential",
      "lang": "en",
      "label": "credential or key material",
      "flags": "",
      "pattern": "\\b(sk-[A-Za-z0-9_-]{12,}|ghp_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)"
    },
    {
      "id": "secret-word",
      "kind": "secret-word",
      "lang": "en",
      "label": "password or secret named in the text",
      "flags": "i",
      "pattern": "\\b(password|passwd|secret|api[ _-]?key|access[ _-]?token|private key|seed phrase)\\b(?:\\s*[:=]\\s*|\\s+is\\s+|\\s+(?=\\S*\\d))\\S+"
    },
    {
      "id": "pin-otp",
      "kind": "pin-otp",
      "lang": "en",
      "label": "PIN, passcode or one-time code named in the text",
      "flags": "i",
      "pattern": "\\b(?:(?:my|the)\\s+)?(pin|passcode|otp|one[ -]?time(?:\\s+(?:code|password|passcode))?|cvv|cvc)\\b(?:\\s*(?:is|:|=)\\s*|\\s+(?=\\d{4,}))\\S+"
    },
    {
      "id": "ledger",
      "kind": "ledger",
      "lang": "en",
      "label": "business ledger or bank-account figures",
      "flags": "i",
      "pattern": "\\bFRIDAY_LEDGER\\b|\\b(IFSC|IBAN)\\b[-\\s:]*[A-Z0-9]{6,}|\\b(account (number|no\\.?)|a/c)\\s*[:#]?\\s*\\d{8,}"
    },
    {
      "id": "hindi-named",
      "kind": "hindi-named",
      "lang": "hi",
      "label": "password, PIN or one-time code with its value, named in Hindi",
      "flags": "i",
      "pattern": "(?<![ऀ-ॿ])(?:पासवर्ड|पासकोड|ओटीपी|सीवीवी|पीआईएन|पिन(?![ऀ-ॿ])(?!\\s*कर)(?!\\s*कोड(?:\\s+(?:है|hai|he|is))?\\s*[:=]?\\s*[0-9]{6}(?![0-9])))(?![ऀ-ॿ]){{named}}"
    },
    {
      "id": "hindi-ambiguous",
      "kind": "hindi-ambiguous",
      "lang": "hi",
      "label": "card, account, ID, secret or token with its value, named in Hindi",
      "flags": "i",
      "pattern": "(?<![ऀ-ॿ])(?:क्रेडिट कार्ड|डेबिट कार्ड|कार्ड न(?:ं|म्)बर|बैंक खाता|खाता (?:संख्या|न(?:ं|म्)बर)|पैन (?:कार्ड|न(?:ं|म्)बर)|एपीआई (?:कुंजी|key)|आधार(?:\\s+(?:कार्ड|न(?:ं|म्)बर|संख्या))?|गुप्त|सीक्रेट|टोकन)(?![ऀ-ॿ]){{plain}}"
    },
    {
      "id": "hinglish-typo",
      "kind": "hinglish-typo",
      "lang": "hinglish",
      "label": "password with its value, written in Roman Hindi",
      "flags": "i",
      "pattern": "\\b(?:paasword|pasword|paaswurd|paswurd|passwurd|paaswd|paasward|passward)\\b{{named}}"
    },
    {
      "id": "hinglish-named",
      "kind": "hinglish-named",
      "lang": "hinglish",
      "label": "PIN, OTP, card, account or ID with its value, written in Roman Hindi",
      "flags": "i",
      "pattern": "\\b(?:(?:password|passwd|passcode|otp|cvv|cvc|pin(?!\\s+code(?:\\s+(?:hai|he|is|है))?\\s*[:=]?\\s*[0-9]{6}(?![0-9])))\\b{{named}}|(?:aadhaar|aadhar|adhaar|khat[ae]|(?:pan|credit|debit|atm)\\s*card|bank\\s+account)\\b{{plain}})"
    },
    {
      "id": "spoken-code",
      "kind": "spoken-code",
      "lang": "hinglish",
      "label": "PIN, OTP, CVV or password said as spaced digits or number words",
      "flags": "i",
      "pattern": "\\b(?:password|passwd|passcode|otp|cvv|cvc|pin(?!\\s+code)|one[ -]?time\\s+(?:password|passcode|code))\\b{{lead}}{{spokenRun}}"
    },
    {
      "id": "spoken-code-hi",
      "kind": "spoken-code",
      "lang": "hi",
      "label": "PIN, OTP, CVV or passcode said as digits or number words in Hindi",
      "flags": "i",
      "pattern": "(?<![ऀ-ॿ])(?:पासवर्ड|पासकोड|ओटीपी|सीवीवी|पीआईएन|वन\\s*टाइम\\s*(?:पासवर्ड|कोड)|पिन(?![ऀ-ॿ])(?!\\s*कोड)(?!\\s*कर))(?![ऀ-ॿ]){{lead}}{{spokenRun}}"
    },
    {
      "id": "code-phrase",
      "kind": "code-phrase",
      "lang": "en",
      "label": "verification or login code with its value",
      "flags": "i",
      "pattern": "\\b(?:(?:verification|verify|security|confirmation|authentication|auth|login|log[ -]?in|sign[ -]?in|one[ -]?time|2fa)\\s+(?:code|pin)\\b{{codeval}}|(?:the|my|your|this|mera|meri|aapka|tumhara|ye|yeh)\\s+code\\b(?:\\s+was)?{{lead}}[0-9]{6}(?![0-9a-z]))"
    },
    {
      "id": "code-phrase-hi",
      "kind": "code-phrase",
      "lang": "hi",
      "label": "verification or login code with its value, named in Hindi",
      "flags": "i",
      "pattern": "(?<![ऀ-ॿ])(?:(?:सत्यापन|वेरिफिकेशन|वेरीफिकेशन|सिक्योरिटी|सिक्यूरिटी|कन्फर्मेशन|लॉगिन)\\s*(?:कोड|पिन)(?![ऀ-ॿ]){{codeval}}|(?:मेरा|मेरी|आपका|तुम्हारा|यह|ये)\\s*कोड(?![ऀ-ॿ]){{lead}}[0-9]{6}(?![0-9a-z]))"
    }
  ]
}
