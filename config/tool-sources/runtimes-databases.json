    },
    "Rust": {
      "home": "machine",
      "homeReason": "rustup installs per user under the profile and shares the toolchain with every tool; it also depends on the machine's MSVC build tools.",
      "sources": [
        {
          "kind": "html-regex",
          "url": "https://static.rust-lang.org/dist/channel-rust-stable.toml",
          "pattern": "\\[pkg\\.rust\\]\\s+version = \"([0-9.]+) "
        },
        {
          "kind": "endoflife",
          "product": "rust"
        },
        {
          "kind": "scoop-manifest",
          "name": "rust"
        }
      ],
      "download": {
        "urlTemplate": "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe",
        "archive": "exe",
        "digestUrl": "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe.sha256"
      },
      "silentInstall": "rustup-init.exe -y --default-toolchain stable --profile minimal",
      "allowUnsigned": true,
      "allowUnsignedReason": "rustup-init.exe is published without an Authenticode signature; its SHA-256 comes from the vendor's own host, static.rust-lang.org.",
      "checked": "2026-11-27"
    },
