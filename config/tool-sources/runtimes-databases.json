    "Go": {
      "home": "friday-root",
      "homeReason": "The zip unpacks to a self-contained GOROOT, no installer and no UAC.",
      "sources": [
        {
          "kind": "json-path",
          "url": "https://go.dev/dl/?mode=json",
          "path": "[0].version",
          "strip": "^go"
        },
        {
          "kind": "text-line",
          "url": "https://go.dev/VERSION?m=text",
          "line": 0,
          "pattern": "^go([0-9.]+)"
        },
        {
          "kind": "endoflife",
          "product": "go"
        }
      ],
      "download": {
        "urlTemplate": "https://go.dev/dl/go{version}.windows-amd64.zip",
