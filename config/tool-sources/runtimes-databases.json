  "version": 1,
  "rows": {
    "Python": {
      "home": "machine",
      "homeReason": "The python.org installer registers the py launcher and PATH for every tool on the PC; per-user mode needs no UAC.",
      "sources": [
        {
          "kind": "html-regex",
          "url": "https://www.python.org/downloads/windows/",
          "pattern": "Python (3\\.14\\.[0-9]+)"
        },
        {
          "kind": "endoflife",
          "product": "python",
          "cycle": "3.14"
        }
      ],
      "download": {
        "urlTemplate": "https://www.python.org/ftp/python/{version}/python-{version}-amd64.exe",
        "archive": "exe"
      },
      "silentInstall": "python-{version}-amd64.exe /quiet InstallAllUsers=0 PrependPath=1 Include_launcher=1 Include_test=0",
      "checked": "2026-11-27"
    },
