    "Node.js LTS": {
      "home": "machine",
      "homeReason": "The MSI installs node and npm system-wide on PATH and asks for UAC.",
      "sources": [
        {
          "kind": "html-regex",
          "url": "https://nodejs.org/dist/index.json",
          "pattern": "\"version\":\"v([0-9.]+)\"[^{}]*?\"lts\":\"[A-Za-z]"
        },
        {
          "kind": "scoop-manifest",
          "name": "nodejs-lts"
        }
      ],
      "download": {
        "urlTemplate": "https://nodejs.org/dist/v{version}/node-v{version}-x64.msi",
        "archive": "msi",
        "digestUrl": "https://nodejs.org/dist/v{version}/SHASUMS256.txt"
      },
      "silentInstall": "msiexec /i node-v{version}-x64.msi /qn /norestart",
      "checked": "2026-11-27"
    },
