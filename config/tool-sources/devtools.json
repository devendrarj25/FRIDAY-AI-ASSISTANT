    "NSIS": {
      "home": "machine",
      "homeReason": "The zip has no SHA-256 from any source, so the setup exe (SHA-256 published by the vendor) is used; its installer asks for UAC.",
      "sources": [
        {
          "kind": "html-regex",
          "url": "https://sourceforge.net/projects/nsis/best_release.json",
          "pattern": "nsis-(\\d+(?:\\.\\d+)+)-setup\\.exe"
        },
        {
          "kind": "scoop-manifest",
          "name": "nsis",
          "bucket": "Extras"
        },
        {
          "kind": "html-regex",
          "url": "https://community.chocolatey.org/api/v2/Packages()?$filter=Id%20eq%20'nsis'%20and%20IsLatestVersion&$select=Version",
          "pattern": "<d:Version>([\\d.]+)</d:Version>"
        }
      ],
      "download": {
        "urlTemplate": "https://downloads.sourceforge.net/project/nsis/NSIS%203/{version}/nsis-{version}-setup.exe",
        "archive": "exe",
        "digestUrl": "https://sourceforge.net/projects/nsis/best_release.json",
        "digestPath": "$.release.sha256sum"
      },
      "silentInstall": "nsis-{version}-setup.exe /S",
      "notifyOnly": false,
      "checked": "2026-11-27"
    },
