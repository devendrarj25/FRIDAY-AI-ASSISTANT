      "download": {
        "urlTemplate": "https://github.com/git-for-windows/git/releases/download/v{version}.windows.1/MinGit-{version}-64-bit.zip",
        "archive": "zip",
        "digestUrl": "https://raw.githubusercontent.com/ScoopInstaller/Main/master/bucket/mingit.json",
        "digestPath": "$.architecture.64bit.hash"
      },
      "notifyOnly": false,
      "checked": "2026-11-27"
    },
