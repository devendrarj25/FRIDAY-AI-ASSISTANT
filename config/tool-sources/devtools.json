{
  "version": 1,
  "rows": {
    "Git": {
      "home": "machine",
      "homeReason": "Git for Windows installs system-wide (PATH, credential manager) and asks for UAC; MinGit is the friday-root copy.",
      "sources": [
        {
          "kind": "github-api",
          "repo": "git-for-windows/git",
          "strip": "^v|\\.windows\\.\\d+$"
        },
        {
          "kind": "github-atom",
          "repo": "git-for-windows/git",
          "tagPattern": "^v\\d+\\.\\d+\\.\\d+\\.windows\\.\\d+$",
          "strip": "^v|\\.windows\\.\\d+$"
        },
        {
          "kind": "endoflife",
          "product": "git"
        },
        {
          "kind": "scoop-manifest",
          "name": "git",
          "bucket": "Main"
        }
      ],
      "download": {
        "urlTemplate": "https://github.com/git-for-windows/git/releases/download/v{version}.windows.1/Git-{version}-64-bit.exe",
        "archive": "exe"
      },
      "silentInstall": "Git-{version}-64-bit.exe /SP- /VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
      "notifyOnly": false,
      "checked": "2026-11-27"
    },
    "MinGit": {
      "home": "friday-root",
      "homeReason": "MinGit is a plain zip with no installer, so it stays inside the FRIDAY folder.",
      "sources": [
