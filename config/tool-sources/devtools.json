        "digestUrl": "https://services.gradle.org/distributions/gradle-{version}-bin.zip.sha256"
      },
      "notifyOnly": false,
      "checked": "2026-11-27"
    },
    "Maven": {
      "home": "friday-root",
      "homeReason": "The binary distribution is a zip that runs from any folder (needs a JDK).",
      "sources": [
