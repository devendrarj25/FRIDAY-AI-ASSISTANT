    "LLVM / Clang": {
      "home": "machine",
      "homeReason": "The MSI is about 1 GB and adds itself to PATH system-wide, so it belongs on the PC and asks for UAC.",
      "sources": [
        {
          "kind": "github-api",
          "repo": "llvm/llvm-project",
          "strip": "^llvmorg-"
        },
        {
          "kind": "github-atom",
          "repo": "llvm/llvm-project",
          "tagPattern": "^llvmorg-\\d+\\.\\d+\\.\\d+$",
          "strip": "^llvmorg-"
        },
        {
          "kind": "scoop-manifest",
          "name": "llvm",
          "bucket": "Main"
        },
        {
          "kind": "json-path",
          "url": "https://formulae.brew.sh/api/formula/llvm.json",
          "path": "$.versions.stable"
        }
      ],
      "download": {
        "urlTemplate": "https://github.com/llvm/llvm-project/releases/download/llvmorg-{version}/LLVM-{version}-win64.msi",
        "archive": "msi",
        "digestUrl": "https://raw.githubusercontent.com/ScoopInstaller/Main/master/bucket/llvm.json",
        "digestPath": "$.architecture.64bit.hash"
      },
      "silentInstall": "msiexec /i LLVM-{version}-win64.msi /qn /norestart",
      "notifyOnly": false,
      "checked": "2026-11-27"
    },
    "MSYS2": {
      "home": "friday-root",
      "homeReason": "The base archive unpacks portably and runs its own first-start setup; the setup exe is the machine-wide alternative.",
      "sources": [
        {
          "kind": "html-regex",
          "url": "https://repo.msys2.org/distrib/x86_64/",
          "pattern": "msys2-base-x86_64-(\\d{8})\\.tar\\.xz\"",
          "pick": "highest"
        },
        {
          "kind": "github-atom",
          "repo": "msys2/msys2-installer",
          "tagPattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "strip": "-"
        },
        {
          "kind": "github-api",
          "repo": "msys2/msys2-installer",
          "strip": "-"
        },
        {
          "kind": "html-regex",
          "url": "https://community.chocolatey.org/api/v2/Packages()?$filter=Id%20eq%20'msys2'%20and%20IsLatestVersion&$select=Version",
          "pattern": "<d:Version>([\\d.]+)</d:Version>"
        }
      ],
      "download": {
        "urlTemplate": "https://repo.msys2.org/distrib/x86_64/msys2-base-x86_64-{version}.tar.xz",
        "archive": "tar.xz",
        "digestUrl": "https://raw.githubusercontent.com/ScoopInstaller/Main/master/bucket/msys2.json",
        "digestPath": "$.architecture.64bit.hash"
      },
      "notifyOnly": false,
      "checked": "2026-11-27"
    },
