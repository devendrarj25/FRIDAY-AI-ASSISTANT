        "cmd": ["uv", "uv.exe"],
        "args": ["--version"]
      }
    },
    {
      "id": "aria2",
      "group": "portable",
      "why": "resumable multi-connection downloads",
      "approxBytes": 2000000,
      "probe": {
        "cmd": ["aria2c", "aria2c.exe"],
        "args": ["--version"]
      }
    },
    {
      "id": "FFmpeg",
      "group": "portable",
