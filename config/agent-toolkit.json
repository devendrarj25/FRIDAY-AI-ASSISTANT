      "approxBytes": 100000000,
      "probe": {
        "cmd": ["ffmpeg", "ffmpeg.exe"],
        "args": ["-version"]
      }
    },
    {
      "id": "Git",
      "group": "developer",
      "why": "version control for the agent's projects",
      "approxBytes": 60000000,
      "probe": {
        "cmd": ["git", "git.exe"],
        "args": ["--version"]
      }
    },
    {
      "id": "GitHub CLI",
