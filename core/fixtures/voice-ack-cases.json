        "turnKind": "confirm-turn"
      },
      "expect": {
        "ack": false,
        "reason": "turn-kind"
      }
    },
    {
      "name": "turn kind control gets no acknowledgement",
      "set": {
        "turnKind": "control"
      },
      "expect": {
        "ack": false,
        "reason": "turn-kind"
      }
    },
    {
      "name": "new task gets one",
      "set": {
        "turnKind": "new-task"
      },
      "expect": {
        "ack": true,
        "lang": "en"
      }
    },
    {
      "name": "an approval is open",
      "set": {
        "pendingConfirmation": true
      },
      "expect": {
        "ack": false,
        "reason": "pending-confirmation"
      }
    },
    {
      "name": "the first clause is already ready",
      "set": {
        "firstClauseReady": true
      },
      "expect": {
        "ack": false,
        "reason": "first-clause-ready"
      }
    },
    {
      "name": "she is speaking",
      "set": {
        "speaking": true
      },
      "expect": {
        "ack": false,
        "reason": "speaking"
      }
    },
    {
      "name": "the owner is speaking again",
      "set": {
        "ownerSpeaking": true
      },
      "expect": {
        "ack": false,
        "reason": "owner-speaking"
      }
    },
    {
      "name": "a call hold",
      "set": {
        "callHold": true
      },
      "expect": {
        "ack": false,
        "reason": "call-hold"
      }
    },
    {
      "name": "quiet hours or do not disturb",
      "set": {
        "quiet": true
      },
      "expect": {
        "ack": false,
        "reason": "quiet-hours"
      }
    },
    {
      "name": "whisper mode skips it",
      "set": {
        "whisperMode": true
      },
      "expect": {
        "ack": false,
        "reason": "whisper-mode"
      }
    },
    {
      "name": "narrator budget used up",
      "set": {
        "narratorLinesLeft": 0
      },
      "expect": {
        "ack": false,
        "reason": "narrator-budget"
      }
    },
    {
      "name": "narrator budget below zero",
      "set": {
        "narratorLinesLeft": -2
      },
      "expect": {
        "ack": false,
        "reason": "narrator-budget"
      }
    },
    {
      "name": "narrator has exactly one line left",
      "set": {
        "narratorLinesLeft": 1
      },
      "expect": {
        "ack": true,
        "lang": "en"
      }
    },
    {
      "name": "one acknowledgement per turn",
      "set": {
        "ackedThisTurn": 1
      },
      "expect": {
        "ack": false,
        "reason": "already-acked"
      }
    },
    {
      "name": "answer expected in 300 ms",
      "set": {
        "expectedAnswerMs": 300
      },
      "expect": {
        "ack": false,
        "reason": "quick-answer"
      }
    },
    {
      "name": "answer expected in 599 ms",
      "set": {
        "expectedAnswerMs": 599
      },
      "expect": {
        "ack": false,
        "reason": "quick-answer"
      }
    },
    {
      "name": "answer expected in 600 ms is not quick",
      "set": {
        "expectedAnswerMs": 600
      },
      "expect": {
        "ack": true,
        "lang": "en"
      }
    },
    {
      "name": "answer expected in 5 s",
      "set": {
        "expectedAnswerMs": 5000
      },
      "expect": {
        "ack": true,
        "lang": "en"
      }
    },
    {
      "name": "no clip rendered yet",
      "set": {},
      "expect": {
        "ack": false,
        "reason": "no-clip-ready"
      },
      "ready": "none"
    },
    {
      "name": "only the Hindi clips are ready for an English turn",
      "set": {},
      "expect": {
        "ack": false,
        "reason": "no-clip-ready"
      },
      "ready": "hi"
    },
    {
      "name": "Devanagari turn gets a Devanagari line",
      "set": {
        "heard": "मेरा कैलेंडर खोलो"
      },
      "expect": {
        "ack": true,
        "lang": "hi",
        "ttsLang": "hi"
      }
    },
    {
      "name": "Roman Hindi turn gets a Roman line",
      "set": {
        "heard": "mujhe kal ka weather batao"
      },
      "expect": {
        "ack": true,
        "lang": "hinglish",
        "ttsLang": "hi"
      }
    },
    {
      "name": "Devanagari turn with only English clips is silent",
      "set": {
        "heard": "मेरा कैलेंडर खोलो"
      },
      "expect": {
        "ack": false,
        "reason": "no-clip-ready"
      },
      "ready": "en"
    },
    {
      "name": "delay is added to the confirmed endpoint",
      "set": {
        "endpointAtMs": 10000
      },
      "expect": {
        "ack": true,
        "atMs": 10600
      }
    },
    {
      "name": "a custom delay",
      "set": {
        "endpointAtMs": 10000,
        "delayMs": 250
      },
      "expect": {
        "ack": true,
        "atMs": 10250
      }
    },
    {
      "name": "the owner's name is appended",
      "set": {
        "addressName": "Asha",
        "seed": 1,
        "turn": 1
      },
      "expect": {
        "ack": true,
        "named": true
      }
    },
    {
      "name": "a name that is a yes-word is left off",
      "set": {
        "addressName": "Haan"
      },
      "expect": {
        "ack": true,
        "named": false
      }
    },
    {
      "name": "an empty-letter turn uses the saved Hindi language",
      "set": {
        "heard": "123 ...",
        "fallbackLang": "hi"
      },
      "expect": {
        "ack": true,
        "lang": "hi"
      }
    },
    {
      "name": "an empty-letter turn uses English by default",
      "set": {
        "heard": ""
      },
      "expect": {
        "ack": true,
        "lang": "en"
      }
    }
