{
  "gates": [
    {
      "name": "quiet turn gets an English acknowledgement",
      "set": {},
      "expect": {
        "ack": true,
        "lang": "en",
        "named": false,
        "atMs": 1600
      }
    },
    {
      "name": "chat mode is silent",
      "set": {
        "mode": "chat"
      },
      "expect": {
        "ack": false,
        "reason": "not-auto-mode"
      }
    },
    {
      "name": "manual mode is silent",
      "set": {
        "mode": "manual"
      },
      "expect": {
        "ack": false,
        "reason": "not-auto-mode"
      }
    },
    {
      "name": "spoken replies off",
      "set": {
        "speakReplies": false
      },
      "expect": {
        "ack": false,
        "reason": "speech-off"
      }
    },
    {
      "name": "mute pause or Stop everything",
      "set": {
        "held": true
      },
      "expect": {
        "ack": false,
        "reason": "held"
      }
    },
    {
      "name": "a newer turn started",
      "set": {
        "generation": 3,
        "liveGeneration": 4
      },
      "expect": {
        "ack": false,
        "reason": "stale-generation"
      }
    },
    {
      "name": "turn kind stop-speech gets no acknowledgement",
      "set": {
        "turnKind": "stop-speech"
      },
      "expect": {
        "ack": false,
        "reason": "turn-kind"
      }
    },
    {
      "name": "turn kind task-control gets no acknowledgement",
