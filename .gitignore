# FRIDAY desktop build
dist-desktop
release
.cache

# Transient What's New staged by the release workflow (copied into
# releases/notes/, attached to the GitHub Release); never committed.
release-notes.md

# Development-only FRIDAY folder (no folder selected yet)
.friday-dev/

# Runtime data when the selected FRIDAY folder is this checkout.
# Source trees (config, docs, skills, the models/*.ts indexes) stay tracked.
/cache/
/data/
/voices/
/downloads/
# Stored memories are runtime data; only the .gitkeep that keeps each canonical
# folder in a fresh clone is tracked (config/project-structure.json).
/memory/**
!/memory/*/
!/memory/*/.gitkeep
/state/
/knowledge/
/library/
/sandbox/
/preferences/
/runtime/
/database/*.sqlite3
/database/*.db
/database/*.db-*
/models/*.bin
/models/*.onnx
/models/*.gguf
/models/**/*.bin
/models/**/*.onnx
/models/**/*.gguf
/models/**/*.safetensors
bun.lock
.friday-readiness-root/

# Isolated Python environments created by setup. Not part of the installer.
.venv/
runtime/.venv/

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Python bytecode caches (kernel runs with -B; strays are still ignored)
__pycache__/
*.pyc

# Portable TEST build marker — generated by .github/workflows/test-build.yml,
# never committed (a committed marker would make a production EXE run as test).
resources/build-channel.json

# FRIDAY runtime artifacts (produced by in-app builds, updates and diagnostics).
# The folders themselves stay in the repository through their .gitkeep files.
releases/installers/*
!releases/installers/.gitkeep
releases/current/*
!releases/current/.gitkeep
releases/previous/*
!releases/previous/.gitkeep
/updates/
temporary/**
!temporary/**/
!temporary/**/.gitkeep
debug/**
!debug/**/
!debug/**/.gitkeep
backup/**
!backup/**/
!backup/**/.gitkeep

# Pack-time toolchain and speech archives. The notices file stays tracked.
resources/toolchain/**/pack.bin
resources/speech/**/pack.bin

# Generated runtime indexes (desktop connectivity scan / architecture index).
# Rebuilt by the installed app and by tests; never a second source of truth.
database/connectivity-graph.json
database/architecture-index.json

# Editor and assistant config folders. Never commit these.
# AGENTS.md and CLAUDE.md stay tracked.
.claude/
.windsurf/
.codex/
.gemini/
.aider*
.continue/
.cline/
.kiro/
.junie/
.cursorrules
.github/copilot-instructions.md
GEMINI.md
.lovable/
