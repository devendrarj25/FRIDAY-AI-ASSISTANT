{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Route Plan",
  "type": "object",
  "required": [
    "planId",
    "strategy",
    "steps",
    "constraints"
  ],
  "properties": {
    "planId": {
      "type": "string"
    },
    "strategy": {
      "enum": [
        "single",
        "fallback",
        "parallel",
        "pipeline",
        "primary-critic",
        "primary-verifier",
        "candidate-judge"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "modelEndpointId",
          "role"
        ],
        "properties": {
          "modelEndpointId": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          },
          "maxTokens": {
            "type": "integer"
          }
        }
      }
    },
    "constraints": {
      "type": "object"
    },
    "explanation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
