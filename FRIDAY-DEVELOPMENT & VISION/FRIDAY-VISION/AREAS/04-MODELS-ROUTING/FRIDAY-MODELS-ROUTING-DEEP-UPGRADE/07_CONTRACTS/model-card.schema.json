{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Model Card",
  "type": "object",
  "required": [
    "id",
    "providerId",
    "nativeModelId",
    "kind",
    "lifecycle",
    "capabilities",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "providerId": {
      "type": "string"
    },
    "nativeModelId": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "cloud",
        "local",
        "gateway"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "stable",
            "preview",
            "experimental",
            "deprecated",
            "retired",
            "unknown"
          ]
        },
        "deprecationAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "endOfLifeAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "confidence",
          "sourceType",
          "observedAt"
        ],
        "properties": {
          "value": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sourceType": {
            "enum": [
              "provider_api",
              "runtime",
              "official_docs",
              "official_model_card",
              "verified_probe",
              "curated",
              "heuristic"
            ]
          },
          "sourceRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedAt": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object"
    },
    "pricing": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
