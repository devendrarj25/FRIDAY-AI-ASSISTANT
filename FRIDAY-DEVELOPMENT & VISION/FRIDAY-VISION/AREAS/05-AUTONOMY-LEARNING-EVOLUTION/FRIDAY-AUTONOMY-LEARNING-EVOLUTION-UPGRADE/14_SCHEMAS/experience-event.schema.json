{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Experience Event",
  "type": "object",
  "required": [
    "eventId",
    "taskId",
    "outcome",
    "verified",
    "timestamp"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "route": {
      "type": "object"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "partial",
        "cancelled"
      ]
    },
    "verified": {
      "type": "boolean"
    },
    "verifierEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "userFeedback": {
      "type": [
        "string",
        "null"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "lessonCandidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
