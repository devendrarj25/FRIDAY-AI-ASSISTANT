{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Scoped Autonomy Policy",
  "type": "object",
  "required": [
    "level",
    "classes",
    "budgets"
  ],
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "approval",
          "sandbox"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "approval": {
            "type": "string",
            "enum": [
              "auto",
              "review",
              "always-review"
            ]
          },
          "sandbox": {
            "type": "boolean"
          },
          "maxRuns": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "minutes": {
          "type": "number",
          "minimum": 0
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "networkRequests": {
          "type": "integer",
          "minimum": 0
        },
        "subprocesses": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
