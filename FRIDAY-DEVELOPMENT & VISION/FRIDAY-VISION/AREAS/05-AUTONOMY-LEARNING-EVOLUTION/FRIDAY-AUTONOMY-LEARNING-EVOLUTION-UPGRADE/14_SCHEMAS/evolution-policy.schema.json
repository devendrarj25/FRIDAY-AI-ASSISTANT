{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Evolution Policy",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "maxGenerations": {
      "type": "integer",
      "minimum": 1
    },
    "populationSize": {
      "type": "integer",
      "minimum": 2
    },
    "maxMinutes": {
      "type": "number",
      "minimum": 1
    },
    "requireIndependentEvaluator": {
      "type": "boolean"
    },
    "allowedArtifactKinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "productionPromotion": {
      "type": "string",
      "enum": [
        "never",
        "review",
        "policy"
      ]
    }
  }
}
