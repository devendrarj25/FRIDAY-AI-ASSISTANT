{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Growth Opportunity",
  "type": "object",
  "required": [
    "id",
    "capability",
    "priority",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "priority": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "recommendedCurriculum": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedGain": {
      "type": "number"
    },
    "expectedCost": {
      "type": "number"
    }
  }
}
