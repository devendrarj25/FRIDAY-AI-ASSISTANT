{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Capability Node",
  "type": "object",
  "required": [
    "id",
    "domain",
    "score",
    "evidenceCount"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "failureModes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
