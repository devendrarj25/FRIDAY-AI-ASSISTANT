{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Change Permission",
  "type": "object",
  "required": [
    "artifactKind",
    "approval",
    "sandbox",
    "rollbackRequired"
  ],
  "properties": {
    "artifactKind": {
      "type": "string"
    },
    "approval": {
      "type": "string",
      "enum": [
        "auto",
        "review",
        "always-review"
      ]
    },
    "sandbox": {
      "type": "boolean"
    },
    "rollbackRequired": {
      "type": "boolean"
    },
    "protected": {
      "type": "boolean"
    }
  }
}
