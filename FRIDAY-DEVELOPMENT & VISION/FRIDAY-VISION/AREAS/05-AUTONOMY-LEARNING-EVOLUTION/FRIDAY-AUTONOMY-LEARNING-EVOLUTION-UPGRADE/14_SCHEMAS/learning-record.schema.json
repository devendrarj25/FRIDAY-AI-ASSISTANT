{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Learning Record",
  "type": "object",
  "required": [
    "id",
    "type",
    "evidence",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "fact",
        "procedure",
        "preference",
        "policy-prior",
        "failure-rule"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scope": {
      "type": "string"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
