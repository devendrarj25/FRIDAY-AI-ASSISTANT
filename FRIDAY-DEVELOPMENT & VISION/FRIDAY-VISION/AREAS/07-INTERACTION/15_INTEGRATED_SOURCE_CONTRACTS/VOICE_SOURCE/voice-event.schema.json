{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "friday://voice/event",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "timestamp",
    "source"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "voice",
        "camera",
        "screen",
        "device",
        "task",
        "notification",
        "system"
      ]
    },
    "sessionId": {
      "type": "string"
    },
    "generationId": {
      "type": "integer"
    },
    "payload": {
      "type": "object"
    }
  }
}
