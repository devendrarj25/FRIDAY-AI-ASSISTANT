{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "friday://voice/artifact",
  "type": "object",
  "required": [
    "artifactId",
    "kind",
    "version",
    "targets",
    "sha256",
    "licenseRefs",
    "dependencies",
    "healthProbe"
  ],
  "properties": {
    "artifactId": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "runtime",
        "executable",
        "library",
        "python",
        "model",
        "voice",
        "wake-model",
        "license",
        "notice"
      ]
    },
    "version": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "licenseRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "healthProbe": {
      "type": "string"
    }
  }
}
