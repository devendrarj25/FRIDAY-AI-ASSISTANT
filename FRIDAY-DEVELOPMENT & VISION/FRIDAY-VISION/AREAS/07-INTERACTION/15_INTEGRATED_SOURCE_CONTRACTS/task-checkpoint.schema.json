{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chat Task Checkpoint",
  "type": "object",
  "required": [
    "taskId",
    "turnId",
    "state",
    "verifiedSteps"
  ],
  "properties": {
    "taskId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "awaiting-approval",
        "paused",
        "completed",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "verifiedSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stepId",
          "status"
        ],
        "properties": {
          "stepId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "failed",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array"
          }
        }
      }
    },
    "nextStep": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAt": {
      "type": "integer"
    }
  }
}
