{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Result",
  "type": "object",
  "required": [
    "status",
    "evidence"
  ],
  "properties": {
    "status": {
      "enum": [
        "verified",
        "failed",
        "unknown",
        "not-applicable"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
