{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilityId",
    "version",
    "availability",
    "inputSchemaVersion",
    "outputSchemaVersion"
  ],
  "properties": {
    "capabilityId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "availability": {
      "enum": [
        "compatible",
        "compatible_with_degraded_presentation",
        "requires_client_upgrade",
        "requires_server_upgrade",
        "unsupported"
      ]
    },
    "inputSchemaVersion": {
      "type": "string"
    },
    "outputSchemaVersion": {
      "type": "string"
    },
    "riskClass": {
      "type": "string"
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "requiresPermissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supportsStreaming": {
      "type": "boolean"
    },
    "supportsArtifacts": {
      "type": "boolean"
    },
    "presentationPrimitives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
