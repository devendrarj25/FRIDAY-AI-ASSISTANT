{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Candidate",
  "type": "object",
  "required": [
    "id",
    "type",
    "available",
    "health",
    "score",
    "retryClass",
    "permission"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "sourceRouter": {
      "type": "string"
    },
    "available": {
      "type": "boolean"
    },
    "health": {
      "enum": [
        "ready",
        "degraded",
        "offline",
        "unknown",
        "open-circuit",
        "half-open"
      ]
    },
    "score": {
      "type": "number"
    },
    "reliability": {
      "type": [
        "number",
        "null"
      ]
    },
    "latencyMs": {
      "type": [
        "number",
        "null"
      ]
    },
    "cost": {
      "type": "string"
    },
    "permission": {
      "type": "string"
    },
    "retryClass": {
      "enum": [
        "safe-read",
        "idempotent-write",
        "non-idempotent-write",
        "unknown"
      ]
    },
    "supportsStreaming": {
      "type": "boolean"
    },
    "supportsCancellation": {
      "type": "boolean"
    }
  }
}
