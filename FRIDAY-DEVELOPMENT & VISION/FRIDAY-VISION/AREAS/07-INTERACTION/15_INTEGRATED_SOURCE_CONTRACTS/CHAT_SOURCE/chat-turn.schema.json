{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Chat Turn",
  "type": "object",
  "required": [
    "conversationId",
    "turnId",
    "generationId",
    "mode",
    "input"
  ],
  "properties": {
    "conversationId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "generationId": {
      "type": "string"
    },
    "taskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "const": "manual"
    },
    "input": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "integer"
    }
  }
}
