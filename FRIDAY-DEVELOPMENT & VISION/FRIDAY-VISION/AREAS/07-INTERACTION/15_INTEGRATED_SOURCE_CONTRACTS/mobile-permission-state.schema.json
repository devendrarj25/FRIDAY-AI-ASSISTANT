{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "permission",
    "browserSupport",
    "state"
  ],
  "properties": {
    "permission": {
      "enum": [
        "microphone",
        "camera",
        "notifications",
        "media",
        "local_network",
        "other"
      ]
    },
    "browserSupport": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "state": {
      "enum": [
        "unknown",
        "prompt",
        "granted",
        "denied",
        "blocked",
        "active",
        "released"
      ]
    },
    "fridaySessionGranted": {
      "type": "boolean"
    },
    "lastCheckedAt": {
      "type": "string"
    }
  }
}
