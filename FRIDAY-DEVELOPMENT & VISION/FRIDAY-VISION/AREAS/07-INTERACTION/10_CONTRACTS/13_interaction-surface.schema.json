{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "friday://contracts/interaction-surface/v1",
  "title": "FRIDAY Interaction Surface",
  "type": "object",
  "required": [
    "surface_id",
    "surface_type",
    "protocol_version",
    "capability_version"
  ],
  "properties": {
    "surface_id": {
      "type": "string"
    },
    "surface_type": {
      "enum": [
        "desktop_chat",
        "desktop_voice",
        "mobile_chat",
        "mobile_voice",
        "notification"
      ]
    },
    "protocol_version": {
      "type": "string"
    },
    "capability_version": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "manual",
        "auto"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    }
  }
}
