{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "friday://contracts/sync-cursor/v1",
  "title": "FRIDAY Runtime Sync Cursor",
  "type": "object",
  "required": [
    "snapshot_version",
    "event_cursor"
  ],
  "properties": {
    "snapshot_version": {
      "type": "string"
    },
    "event_cursor": {
      "type": "string"
    },
    "capability_version": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
