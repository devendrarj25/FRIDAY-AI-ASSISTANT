{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "friday://contracts/media-session/v1",
  "title": "FRIDAY Mobile Media Session",
  "type": "object",
  "required": [
    "media_session_id",
    "kind",
    "state"
  ],
  "properties": {
    "media_session_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "microphone",
        "camera",
        "audio_video"
      ]
    },
    "state": {
      "enum": [
        "requested",
        "permission_required",
        "active",
        "paused",
        "stopped",
        "revoked",
        "unsupported",
        "failed"
      ]
    },
    "transport": {
      "enum": [
        "webrtc",
        "browser_local",
        "none"
      ]
    },
    "permission_evidence_ref": {
      "type": "string"
    }
  }
}
