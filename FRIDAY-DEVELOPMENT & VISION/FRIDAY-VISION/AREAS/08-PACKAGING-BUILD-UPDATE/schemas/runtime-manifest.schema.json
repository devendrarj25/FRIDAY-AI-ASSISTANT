{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Runtime Manifest",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "owner",
    "platforms",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "platforms": {
      "type": "array"
    },
    "artifacts": {
      "type": "array"
    },
    "health": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
