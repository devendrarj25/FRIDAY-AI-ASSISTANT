{
  "schema": 1,
  "officialPayloadMayReplace": [
    "official application payload",
    "official runtime payload",
    "official components"
  ],
  "neverReplace": [
    "user components",
    "user runtimes",
    "user models",
    "user projects",
    "memory",
    "knowledge",
    "user downloads"
  ],
  "requireVerification": true,
  "requireHealthCheck": true,
  "rollbackOnFailure": true
}
