{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Capability Contract v2",
  "type": "object",
  "required": [
    "id",
    "version",
    "kind",
    "intentTags",
    "inputs",
    "outputs",
    "risk",
    "permissions",
    "lifecycle",
    "readiness",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "intentTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "requires": {
      "type": "object"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "lifecycle": {
      "type": "string"
    },
    "readiness": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "health": {
      "type": "object"
    },
    "supports": {
      "type": "object"
    },
    "cost": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    }
  }
}
