{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Policy Decision",
  "type": "object",
  "required": [
    "risk",
    "authority",
    "data_class",
    "decision"
  ],
  "properties": {
    "risk": {
      "type": "string"
    },
    "authority": {
      "type": "object"
    },
    "data_class": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        "approve",
        "modify",
        "defer"
      ]
    },
    "reason": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    }
  }
}
