{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Artifact",
  "type": "object",
  "required": [
    "artifact_id",
    "type",
    "content_hash",
    "provenance",
    "sensitivity"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "sensitivity": {
      "type": "string"
    },
    "parents": {
      "type": "array"
    },
    "children": {
      "type": "array"
    },
    "verification": {
      "type": "object"
    }
  }
}
