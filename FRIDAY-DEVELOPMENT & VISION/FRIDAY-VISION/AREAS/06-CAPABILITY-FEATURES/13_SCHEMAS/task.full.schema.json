{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRIDAY Durable Task",
  "type": "object",
  "required": [
    "task_id",
    "goal",
    "state",
    "plan",
    "policy_snapshot",
    "budget",
    "checkpoint"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "goal": {
      "type": "object"
    },
    "state": {
      "type": "string"
    },
    "plan": {
      "type": "object"
    },
    "policy_snapshot": {
      "type": "object"
    },
    "budget": {
      "type": "object"
    },
    "checkpoint": {
      "type": "object"
    },
    "artifacts": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "trace_id": {
      "type": "string"
    },
    "idempotency": {
      "type": "object"
    }
  }
}
