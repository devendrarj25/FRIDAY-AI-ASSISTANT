{
  "id": "github-notifications-if-connected",
  "name": "GitHub notifications if connected",
  "version": "1.0.0",
  "description": "GitHub notifications/issues/repos only when connected; git dirty still runs locally.",
  "category": "research",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "daily 09:15",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Scan git dirty files locally",
      "kind": "agent",
      "ref": "agents/core/git-dirty-scanner",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Read git HEAD",
      "kind": "agent",
      "ref": "agents/core/git-branch-head-reader",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "GitHub notifications if connected",
      "kind": "connector",
      "ref": "github",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Draft a status line",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Keep the digest local",
      "kind": "note",
      "ref": "gh-digest",
      "risk": "safe"
    }
  ]
}
