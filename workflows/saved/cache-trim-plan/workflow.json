{
  "id": "cache-trim-plan",
  "name": "Cache trim plan",
  "version": "1.0.0",
  "description": "Plan cache trim, pycache clean, coverage artifacts, editor swap files. Mutates only with approval.",
  "category": "maintenance",
  "risk": "write",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "monthly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Plan cache trim",
      "kind": "agent",
      "ref": "agents/core/cache-trim",
      "risk": "write"
    },
    {
      "id": "s2",
      "label": "Find Python pycache",
      "kind": "agent",
      "ref": "agents/core/python-pycache-cleaner",
      "risk": "write"
    },
    {
      "id": "s3",
      "label": "Find coverage artifacts",
      "kind": "agent",
      "ref": "agents/core/coverage-artifact-cleaner",
      "risk": "write"
    },
    {
      "id": "s4",
      "label": "Find editor swap files",
      "kind": "agent",
      "ref": "agents/core/editor-swap-cleaner",
      "risk": "write"
    },
    {
      "id": "s5",
      "label": "Find build artifacts",
      "kind": "agent",
      "ref": "agents/core/build-artifact-scanner",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft the trim list",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Hold deletes until approved",
      "kind": "note",
      "ref": "cache-plan",
      "risk": "safe"
    }
  ]
}
