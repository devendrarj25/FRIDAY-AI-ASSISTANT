{
  "id": "evening-full-close",
  "name": "Evening full-close chain",
  "version": "1.0.0",
  "description": "Longer evening close: today's file changes, TODOs, git HEAD, dirty names, large logs, disk, a wrap status, thanks draft, then a local journal. Nothing is posted.",
  "category": "office",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "daily 19:00",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "List files that changed today",
      "kind": "agent",
      "ref": "agents/core/workspace-change-scanner",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Harvest TODO comments",
      "kind": "agent",
      "ref": "agents/core/workspace-todo-scanner",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Read git HEAD stamp",
      "kind": "agent",
      "ref": "agents/core/git-branch-head-reader",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Scan git dirty files (names only)",
      "kind": "agent",
      "ref": "agents/core/git-dirty-scanner",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Watch large log files",
      "kind": "agent",
      "ref": "agents/core/large-log-watcher",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Measure workspace disk hotspot",
      "kind": "agent",
      "ref": "agents/core/disk-hotspot-walker",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Draft a wrap-up status line",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s8",
      "label": "Draft a short thanks note",
      "kind": "skill",
      "ref": "skills/custom/com-thanks",
      "risk": "safe"
    },
    {
      "id": "s9",
      "label": "File the evening journal locally",
      "kind": "note",
      "ref": "evening-full-close",
      "risk": "safe"
    }
  ]
}
