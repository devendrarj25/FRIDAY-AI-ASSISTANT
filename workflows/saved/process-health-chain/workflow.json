{
  "id": "process-health-chain",
  "name": "Process health chain",
  "version": "1.0.0",
  "description": "Snapshot processes, CPU/memory, uptime, network connections (names), then a local health line.",
  "category": "maintenance",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "daily 09:00",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Snapshot process health",
      "kind": "agent",
      "ref": "agents/core/process-health-snapshot",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Snapshot CPU and memory",
      "kind": "agent",
      "ref": "agents/core/cpu-memory-snapshot",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Read uptime",
      "kind": "agent",
      "ref": "agents/core/uptime-snapshot",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Snapshot network connection names",
      "kind": "agent",
      "ref": "agents/core/network-connection-snapshot",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Audit startup program names",
      "kind": "agent",
      "ref": "agents/core/startup-program-auditor",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft the health line",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Keep the snapshot local",
      "kind": "note",
      "ref": "process-health",
      "risk": "safe"
    }
  ]
}
