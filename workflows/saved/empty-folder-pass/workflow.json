{
  "id": "empty-folder-pass",
  "name": "Empty-folder pass",
  "version": "1.0.0",
  "description": "Find empty folders, zero-byte files, leftover extracts, then a removal plan. Deletes stay approval-gated.",
  "category": "files",
  "risk": "write",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Find empty folders",
      "kind": "agent",
      "ref": "agents/core/empty-folder-cleaner",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Find zero-byte files",
      "kind": "agent",
      "ref": "agents/core/zero-byte-file-cleaner",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Find leftover extracts",
      "kind": "agent",
      "ref": "agents/core/leftover-extract-scanner",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Find leftover patches",
      "kind": "agent",
      "ref": "agents/core/leftover-patch-cleaner",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Walk the folder tree",
      "kind": "tool",
      "ref": "tools/filesystem/file-tree",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft what would be removed",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Wait for delete approval",
      "kind": "note",
      "ref": "empty-folder-plan",
      "risk": "safe"
    }
  ]
}
