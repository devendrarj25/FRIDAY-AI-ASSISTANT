{
  "id": "temp-file-pass",
  "name": "Temp-file pass",
  "version": "1.0.0",
  "description": "Find temp files, leftover extracts, leftover patches, then a cleanup plan.",
  "category": "maintenance",
  "risk": "write",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Find temp files",
      "kind": "agent",
      "ref": "agents/core/temp-file-cleanup",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Find leftover extracts",
      "kind": "agent",
      "ref": "agents/core/leftover-extract-scanner",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Find leftover patches",
      "kind": "agent",
      "ref": "agents/core/leftover-patch-cleaner",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Find zero-byte files",
      "kind": "agent",
      "ref": "agents/core/zero-byte-file-cleaner",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "List temp-looking names",
      "kind": "tool",
      "ref": "tools/filesystem/file-search",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft the cleanup",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Wait for delete approval",
      "kind": "note",
      "ref": "temp-plan",
      "risk": "safe"
    }
  ]
}
