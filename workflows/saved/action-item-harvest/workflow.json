{
  "id": "action-item-harvest",
  "name": "Action-item harvest",
  "version": "1.0.0",
  "description": "Pull action-shaped lines from notes, TODOs, RFIs, and meeting-ask drafts into one local list.",
  "category": "office",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "on demand",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Scan TODO comments",
      "kind": "agent",
      "ref": "agents/core/workspace-todo-scanner",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Word-count notes for long threads",
      "kind": "agent",
      "ref": "agents/core/text-notes-wordcount",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Load an RFI checklist skill",
      "kind": "skill",
      "ref": "skills/custom/con-rfi-checklist",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Load a phase checklist",
      "kind": "skill",
      "ref": "skills/custom/con-phase-checklist",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Draft a meeting ask for blockers",
      "kind": "skill",
      "ref": "skills/custom/com-meeting-ask",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft a status update",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Keep the action list local",
      "kind": "note",
      "ref": "action-list",
      "risk": "safe"
    }
  ]
}
