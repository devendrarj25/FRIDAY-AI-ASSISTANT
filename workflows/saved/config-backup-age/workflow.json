{
  "id": "config-backup-age",
  "name": "Config backup age chain",
  "version": "1.0.0",
  "description": "Remind if config backups are stale, audit FRIDAY root age, JSON config inventory, then a copy plan.",
  "category": "maintenance",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Remind if config backup is stale",
      "kind": "agent",
      "ref": "agents/core/config-backup-reminder",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Audit FRIDAY root age",
      "kind": "agent",
      "ref": "agents/core/friday-root-age-auditor",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Inventory JSON configs",
      "kind": "agent",
      "ref": "agents/core/json-config-inventory",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Find stale backup folders",
      "kind": "agent",
      "ref": "agents/core/stale-backup-folder-scanner",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Plan a folder copy",
      "kind": "agent",
      "ref": "agents/core/folder-copy-planner",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft the backup note",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Keep the reminder local",
      "kind": "note",
      "ref": "backup-age",
      "risk": "safe"
    }
  ]
}
