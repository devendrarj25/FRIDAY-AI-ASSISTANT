{
  "id": "weekly-status-rollup",
  "name": "Weekly status rollup",
  "version": "1.0.0",
  "description": "Roll a week of local work: git dirty, changelog presence, TODOs, CSV expense names, then a status update. Nothing leaves the PC.",
  "category": "office",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly Friday 16:00",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Scan git dirty files",
      "kind": "agent",
      "ref": "agents/core/git-dirty-scanner",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Find a changelog file",
      "kind": "module",
      "ref": "modules/developer/changelog-head",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Scan TODO comments",
      "kind": "agent",
      "ref": "agents/core/workspace-todo-scanner",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Total CSV expense filenames",
      "kind": "agent",
      "ref": "agents/core/csv-expense-total",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Draft the weekly status",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Ask for an update if a thread stalled",
      "kind": "skill",
      "ref": "skills/custom/com-ask-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Save the rollup as a local note",
      "kind": "note",
      "ref": "weekly-rollup",
      "risk": "safe"
    }
  ]
}
