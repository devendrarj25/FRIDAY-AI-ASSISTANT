{
  "id": "morning-briefing",
  "name": "Morning briefing chain",
  "version": "1.0.0",
  "description": "Local morning desk: upcoming ICS names, overdue dated files, git dirty state, disk snapshot, then a spoken-ready digest. Calendar connectors run only when connected; otherwise that step fails honestly.",
  "category": "office",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "daily 08:00",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Read upcoming .ics event titles",
      "kind": "agent",
      "ref": "agents/core/ics-upcoming-events",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Flag overdue dated filenames",
      "kind": "agent",
      "ref": "agents/core/overdue-dated-filename-scanner",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Scan git dirty files (names only)",
      "kind": "agent",
      "ref": "agents/core/git-dirty-scanner",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Snapshot CPU and memory",
      "kind": "agent",
      "ref": "agents/core/cpu-memory-snapshot",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Measure workspace disk hotspot",
      "kind": "agent",
      "ref": "agents/core/disk-hotspot-walker",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "List Google Calendar events if connected",
      "kind": "connector",
      "ref": "google-calendar",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Draft a status blurb from those findings",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s8",
      "label": "Keep a local morning note — no web post",
      "kind": "note",
      "ref": "local-digest",
      "risk": "safe"
    }
  ]
}
