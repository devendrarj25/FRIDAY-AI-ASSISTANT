{
  "id": "self-health",
  "name": "Self-health inspect chain",
  "version": "1.0.0",
  "description": "FRIDAY inspects her own machine signals: uptime, process health, disk hotspot, large logs, config age, then a local health note. No fake repair.",
  "category": "maintenance",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "every 6h",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Read uptime snapshot",
      "kind": "agent",
      "ref": "agents/core/uptime-snapshot",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Snapshot process health",
      "kind": "agent",
      "ref": "agents/core/process-health-snapshot",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Walk disk hotspots",
      "kind": "agent",
      "ref": "agents/core/disk-hotspot-walker",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Watch large logs",
      "kind": "agent",
      "ref": "agents/core/large-log-watcher",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Audit FRIDAY root age",
      "kind": "agent",
      "ref": "agents/core/friday-root-age-auditor",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Remind if config backup is stale",
      "kind": "agent",
      "ref": "agents/core/config-backup-reminder",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Draft a health status line",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s8",
      "label": "Keep findings in a local note",
      "kind": "note",
      "ref": "health-note",
      "risk": "safe"
    }
  ]
}
