{
  "id": "github-issue-triage-if-connected",
  "name": "GitHub issue triage if connected",
  "version": "1.0.0",
  "description": "Local git dirty + GitHub issues/notifications when connected.",
  "category": "connectors",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "daily 09:45",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Scan git dirty files",
      "kind": "agent",
      "ref": "agents/core/git-dirty-scanner",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Workspace TODOs",
      "kind": "agent",
      "ref": "agents/core/workspace-todo-scanner",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "GitHub if connected",
      "kind": "connector",
      "ref": "github",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Draft a triage status",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "PR checklist skill",
      "kind": "skill",
      "ref": "skills/custom/code-pr-checklist",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Keep triage local",
      "kind": "note",
      "ref": "gh-triage",
      "risk": "safe"
    }
  ]
}
