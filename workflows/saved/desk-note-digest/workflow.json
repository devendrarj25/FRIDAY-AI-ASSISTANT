{
  "id": "desk-note-digest",
  "name": "Desk note digest",
  "version": "1.0.0",
  "description": "Digest text notes, markdown index, and harvested URLs into a short desk brief.",
  "category": "office",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "daily 12:30",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Word-count text notes",
      "kind": "agent",
      "ref": "agents/core/text-notes-wordcount",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Index markdown files",
      "kind": "agent",
      "ref": "agents/core/markdown-index-agent",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Extract README links",
      "kind": "agent",
      "ref": "agents/core/readme-link-extractor",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Harvest URLs from a folder",
      "kind": "agent",
      "ref": "agents/core/url-harvest-from-folder",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Build a markdown TOC",
      "kind": "module",
      "ref": "modules/communication/markdown-toc",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft a status blurb",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Store the digest locally",
      "kind": "note",
      "ref": "desk-digest",
      "risk": "safe"
    }
  ]
}
