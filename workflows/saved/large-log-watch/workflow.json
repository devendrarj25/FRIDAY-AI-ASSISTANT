{
  "id": "large-log-watch",
  "name": "Large-log watch chain",
  "version": "1.0.0",
  "description": "Watch large logs, plan rotation, inspect log files, then a trim plan. Rotation writes wait for approval.",
  "category": "maintenance",
  "risk": "write",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "daily 22:00",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Watch large logs",
      "kind": "agent",
      "ref": "agents/core/large-log-watcher",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Plan log rotation cleanup",
      "kind": "agent",
      "ref": "agents/core/log-rotation-cleanup",
      "risk": "write"
    },
    {
      "id": "s3",
      "label": "Inspect logs via the module",
      "kind": "module",
      "ref": "modules/system/log-inspect",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Find huge files that may be logs",
      "kind": "agent",
      "ref": "agents/core/huge-file-finder",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Stat a named log",
      "kind": "tool",
      "ref": "tools/filesystem/file-stat",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft what would rotate",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Wait for rotation approval",
      "kind": "note",
      "ref": "log-plan",
      "risk": "safe"
    }
  ]
}
