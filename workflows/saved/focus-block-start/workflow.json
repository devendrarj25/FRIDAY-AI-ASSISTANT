{
  "id": "focus-block-start",
  "name": "Focus block start",
  "version": "1.0.0",
  "description": "Start a focus block from real local noise: process snapshot, large logs, desktop clutter plan, then a local timer note. Does not mute Windows notifications by itself.",
  "category": "office",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "on demand",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Snapshot process health",
      "kind": "agent",
      "ref": "agents/core/process-health-snapshot",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Watch large logs",
      "kind": "agent",
      "ref": "agents/core/large-log-watcher",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Inventory desktop shortcuts",
      "kind": "agent",
      "ref": "agents/core/desktop-shortcut-inventory",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Plan desktop clutter sort",
      "kind": "agent",
      "ref": "agents/core/desktop-clutter-sorter",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Draft a status line for the block",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Record the focus goal locally",
      "kind": "note",
      "ref": "focus-goal",
      "risk": "safe"
    }
  ]
}
