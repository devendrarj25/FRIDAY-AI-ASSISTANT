{
  "id": "invoice-filename-hisab",
  "name": "Invoice filename hisab chain",
  "version": "1.0.0",
  "description": "Scan invoices, RA bills, contracts, then a local hisab import draft. No bank login.",
  "category": "bookkeeping",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Scan invoice filenames",
      "kind": "agent",
      "ref": "agents/core/invoice-filename-scanner",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Scan RA bill filenames",
      "kind": "agent",
      "ref": "agents/core/ra-bill-filename-scanner",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Scan contract filenames",
      "kind": "agent",
      "ref": "agents/core/contract-filename-scanner",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Total CSV expenses",
      "kind": "agent",
      "ref": "agents/core/csv-expense-total",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Preview CSV columns",
      "kind": "tool",
      "ref": "tools/filesystem/csv-preview",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft the import note",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Keep hisab local",
      "kind": "note",
      "ref": "hisab-import",
      "risk": "safe"
    }
  ]
}
