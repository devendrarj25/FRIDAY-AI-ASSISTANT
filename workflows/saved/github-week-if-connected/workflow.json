{
  "id": "github-week-if-connected",
  "name": "GitHub week if connected",
  "version": "1.0.0",
  "description": "GitHub week: notifications and issues only if connected (honest miss otherwise), plus local dirty files, changelog, Slack digest if connected, then a local status. No comments are posted.",
  "category": "connectors",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly Monday 09:00",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "GitHub notifications if connected",
      "kind": "connector",
      "ref": "github",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "GitHub issues if connected",
      "kind": "connector",
      "ref": "github",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Scan git dirty files (names only)",
      "kind": "agent",
      "ref": "agents/core/git-dirty-scanner",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Read git HEAD stamp",
      "kind": "agent",
      "ref": "agents/core/git-branch-head-reader",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Read changelog head",
      "kind": "module",
      "ref": "modules/developer/changelog-head",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Slack digest if connected",
      "kind": "connector",
      "ref": "slack",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Draft a status update",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s8",
      "label": "Keep the GitHub week note local",
      "kind": "note",
      "ref": "github-week",
      "risk": "safe"
    }
  ]
}
