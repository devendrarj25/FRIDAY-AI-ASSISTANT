{
  "id": "node-modules-size-check",
  "name": "node_modules size check",
  "version": "1.0.0",
  "description": "Audit node_modules size, lockfiles, package scripts, coverage artifacts — inspect only.",
  "category": "maintenance",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "monthly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Audit node_modules size",
      "kind": "agent",
      "ref": "agents/core/node-modules-size-auditor",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Audit lockfile presence",
      "kind": "agent",
      "ref": "agents/core/lockfile-presence-auditor",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Inventory package scripts",
      "kind": "agent",
      "ref": "agents/core/package-script-inventory",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Find coverage artifacts",
      "kind": "agent",
      "ref": "agents/core/coverage-artifact-cleaner",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Read package.json keys via module",
      "kind": "module",
      "ref": "modules/developer/package-scripts",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft the size note",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
