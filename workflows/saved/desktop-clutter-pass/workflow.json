{
  "id": "desktop-clutter-pass",
  "name": "Desktop clutter pass",
  "version": "1.0.0",
  "description": "Inventory desktop shortcuts, sort clutter, find screenshots on the desk, then a move plan.",
  "category": "files",
  "risk": "write",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Inventory desktop shortcuts",
      "kind": "agent",
      "ref": "agents/core/desktop-shortcut-inventory",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Sort desktop clutter by name",
      "kind": "agent",
      "ref": "agents/core/desktop-clutter-sorter",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Organise screenshot dumps",
      "kind": "agent",
      "ref": "agents/core/screenshot-dump-organizer",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Find empty folders on the desk tree",
      "kind": "agent",
      "ref": "agents/core/empty-folder-cleaner",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "List desktop files",
      "kind": "tool",
      "ref": "tools/filesystem/file-list",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft the tidy plan",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Hold moves until approved",
      "kind": "note",
      "ref": "desktop-plan",
      "risk": "safe"
    }
  ]
}
