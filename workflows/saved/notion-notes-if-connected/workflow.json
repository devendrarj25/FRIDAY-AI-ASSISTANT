{
  "id": "notion-notes-if-connected",
  "name": "Notion notes if connected",
  "version": "1.0.0",
  "description": "Index local markdown first; Notion runs only when connected.",
  "category": "connectors",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "on demand",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Index local markdown",
      "kind": "agent",
      "ref": "agents/core/markdown-index-agent",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Word-count text notes",
      "kind": "agent",
      "ref": "agents/core/text-notes-wordcount",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Notion if connected",
      "kind": "connector",
      "ref": "notion",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Draft a notes status",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Keep a local mirror note",
      "kind": "note",
      "ref": "notion-mirror",
      "risk": "safe"
    }
  ]
}
