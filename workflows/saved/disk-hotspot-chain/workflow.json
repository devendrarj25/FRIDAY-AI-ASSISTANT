{
  "id": "disk-hotspot-chain",
  "name": "Disk hotspot chain",
  "version": "1.0.0",
  "description": "Walk disk hotspots, huge files, large logs, node_modules, then a cache-trim plan. No silent deletes.",
  "category": "maintenance",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Walk disk hotspots",
      "kind": "agent",
      "ref": "agents/core/disk-hotspot-walker",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Watch disk space",
      "kind": "agent",
      "ref": "agents/core/disk-space-watcher",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Find huge files",
      "kind": "agent",
      "ref": "agents/core/huge-file-finder",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Watch large logs",
      "kind": "agent",
      "ref": "agents/core/large-log-watcher",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Audit node_modules size",
      "kind": "agent",
      "ref": "agents/core/node-modules-size-auditor",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Plan cache trim",
      "kind": "agent",
      "ref": "agents/core/cache-trim",
      "risk": "write"
    },
    {
      "id": "s7",
      "label": "Draft the disk note",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s8",
      "label": "Keep the hotspot report local",
      "kind": "note",
      "ref": "disk-report",
      "risk": "safe"
    }
  ]
}
