{
  "id": "secret-filename-hygiene",
  "name": "Secret-filename hygiene",
  "version": "1.0.0",
  "description": "Scan secret filenames, SSH pubkeys, world-writable paths, hosts file — names and modes only.",
  "category": "privacy",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Scan secret filenames",
      "kind": "agent",
      "ref": "agents/core/secret-filename-scanner",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Inventory SSH public keys",
      "kind": "agent",
      "ref": "agents/core/ssh-public-key-inventory",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Audit SSH folder permissions",
      "kind": "agent",
      "ref": "agents/core/ssh-folder-permission-auditor",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Scan world-writable paths",
      "kind": "agent",
      "ref": "agents/core/world-writable-scanner",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Snapshot hosts file",
      "kind": "agent",
      "ref": "agents/core/hosts-file-snapshot",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Keep a hygiene note — no secret values",
      "kind": "note",
      "ref": "privacy-hygiene",
      "risk": "safe"
    }
  ]
}
