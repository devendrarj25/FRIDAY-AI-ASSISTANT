{
  "id": "zip-archive-census",
  "name": "Zip archive census",
  "version": "1.0.0",
  "description": "Inventory zip archives, list contents, hash a sample, and note old archives — inspect only.",
  "category": "files",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "monthly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Inventory zip archives",
      "kind": "agent",
      "ref": "agents/core/zip-archive-inventory",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Find old archives",
      "kind": "agent",
      "ref": "agents/core/old-archive-cleaner",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Find leftover extracts",
      "kind": "agent",
      "ref": "agents/core/leftover-extract-scanner",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "List archive member names",
      "kind": "tool",
      "ref": "tools/filesystem/archive-list",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Hash a file when you name it",
      "kind": "tool",
      "ref": "tools/filesystem/file-hash",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft the census",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Keep the census local",
      "kind": "note",
      "ref": "zip-census",
      "risk": "safe"
    }
  ]
}
