{
  "id": "ssh-folder-permission",
  "name": "SSH folder permission chain",
  "version": "1.0.0",
  "description": "Audit SSH folder modes, public keys, private-key path alerts — no private-key contents.",
  "category": "privacy",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "monthly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Audit SSH folder permissions",
      "kind": "agent",
      "ref": "agents/core/ssh-folder-permission-auditor",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Inventory SSH public keys",
      "kind": "agent",
      "ref": "agents/core/ssh-public-key-inventory",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Alert on private-key paths",
      "kind": "agent",
      "ref": "agents/core/private-key-path-alert",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Scan secret filenames",
      "kind": "agent",
      "ref": "agents/core/secret-filename-scanner",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Draft the SSH note",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Keep modes only — no key material",
      "kind": "note",
      "ref": "ssh-audit",
      "risk": "safe"
    }
  ]
}
