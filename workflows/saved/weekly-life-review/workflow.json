{
  "id": "weekly-life-review",
  "name": "Weekly life-review chain",
  "version": "1.0.0",
  "description": "Sunday close: upcoming ICS titles, overdue dated files, git dirty names, disk hotspot, desk notes, Slack digest only if connected, then a local weekly status. Nothing is posted to the web.",
  "category": "office",
  "risk": "safe",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly Sunday 17:00",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Read upcoming .ics event titles",
      "kind": "agent",
      "ref": "agents/core/ics-upcoming-events",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Flag overdue dated filenames",
      "kind": "agent",
      "ref": "agents/core/overdue-dated-filename-scanner",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Scan git dirty files (names only)",
      "kind": "agent",
      "ref": "agents/core/git-dirty-scanner",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Measure workspace disk hotspot",
      "kind": "agent",
      "ref": "agents/core/disk-hotspot-walker",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "Word-count desk notes",
      "kind": "agent",
      "ref": "agents/core/text-notes-wordcount",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Slack digest if connected",
      "kind": "connector",
      "ref": "slack",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Harvest TODO comments",
      "kind": "agent",
      "ref": "agents/core/workspace-todo-scanner",
      "risk": "safe"
    },
    {
      "id": "s8",
      "label": "Draft a weekly status blurb",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s9",
      "label": "Keep the review local — no web post",
      "kind": "note",
      "ref": "weekly-review",
      "risk": "safe"
    }
  ]
}
