{
  "id": "leftover-extract-pass",
  "name": "Leftover extract pass",
  "version": "1.0.0",
  "description": "Find leftover extracts, installer leftovers, old ISOs, then an archive inventory. Cleanup writes wait for approval.",
  "category": "files",
  "risk": "write",
  "enabled": false,
  "permissions": [],
  "inputs": [],
  "schedule": "weekly",
  "author": "FRIDAY library",
  "steps": [
    {
      "id": "s1",
      "label": "Find leftover extracts",
      "kind": "agent",
      "ref": "agents/core/leftover-extract-scanner",
      "risk": "safe"
    },
    {
      "id": "s2",
      "label": "Find installer leftovers",
      "kind": "agent",
      "ref": "agents/core/installer-leftover-cleaner",
      "risk": "safe"
    },
    {
      "id": "s3",
      "label": "Find old ISO files",
      "kind": "agent",
      "ref": "agents/core/old-iso-scanner",
      "risk": "safe"
    },
    {
      "id": "s4",
      "label": "Inventory zip archives",
      "kind": "agent",
      "ref": "agents/core/zip-archive-inventory",
      "risk": "safe"
    },
    {
      "id": "s5",
      "label": "List archive contents (names)",
      "kind": "tool",
      "ref": "tools/filesystem/archive-list",
      "risk": "safe"
    },
    {
      "id": "s6",
      "label": "Draft what can go",
      "kind": "skill",
      "ref": "skills/custom/com-status-update",
      "risk": "safe"
    },
    {
      "id": "s7",
      "label": "Wait for cleanup approval",
      "kind": "note",
      "ref": "extract-plan",
      "risk": "safe"
    }
  ]
}
